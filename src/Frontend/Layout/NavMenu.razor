<MudAppBar Color="Color.Primary" Elevation="0">
    <MudText Typo="Typo.h6">Portfolio</MudText>
    <MudSpacer />
    <MudMenuItem Icon="@Icons.Material.TwoTone.DarkMode"
                    IconColor="Color.Secondary"
                    Width="0"/>
    <MudFabMenu StartIcon="@Icons.Material.Filled.Menu"
                    Color="Color.Secondary"
                    Direction="Direction.Left"
                    Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudNavLink Href="" Match="NavLinkMatch.All">
                <MudFabMenuItem StartIcon="@Icons.Material.Filled.Home" Label="Home" Color="Color.Secondary" />
            </MudNavLink>
            <MudNavLink Href="about">
                <MudFabMenuItem StartIcon="@Icons.Material.Filled.Info" Label="Sobre" Color="Color.Secondary" />
            </MudNavLink>
            <MudNavLink Href="projects">
                <MudFabMenuItem StartIcon="@Icons.Material.Filled.Work" Label="Projetos" Color="Color.Secondary" />
            </MudNavLink>
            <MudNavLink Href="contact">
                <MudFabMenuItem StartIcon="@Icons.Material.Filled.ContactMail" Label="Contato" Color="Color.Secondary" />
            </MudNavLink>
    </MudFabMenu>

</MudAppBar>